# LiveKit (the only credentials this chapter needs)
#
# Chapter 1 routes STT, LLM, and TTS through LiveKit Inference
# (inference.STT/LLM/TTS in agent.py), so the provider models are billed
# through your LiveKit account. No separate provider keys are required.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: only needed if you follow the chapter's alternative and swap the
# inference.* calls for direct provider plugins (deepgram.STT, openai.LLM,
# cartesia.TTS). Leave these blank when running agent.py as written.
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
